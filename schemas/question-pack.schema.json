{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duelodosaber.local/schemas/question-pack.schema.json",
  "title": "Duelo do Saber Question Pack",
  "type": "object",
  "required": [
    "format_version",
    "package_id",
    "title",
    "description",
    "language",
    "generated_at",
    "subjects",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "alternative": {
      "type": "object",
      "required": [
        "id",
        "card_name",
        "description",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "card_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "topic",
        "difficulty",
        "styles",
        "prompt",
        "alternatives",
        "correct_alternative",
        "correct_explanation",
        "hint",
        "source_reference",
        "keywords"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "subtopic": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "concept",
              "memorization",
              "literalness",
              "interpretation",
              "comparison",
              "application",
              "practical_case",
              "calculation",
              "exception",
              "trick",
              "association",
              "sequence",
              "interdisciplinary"
            ]
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "correct_alternative": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "correct_explanation": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
